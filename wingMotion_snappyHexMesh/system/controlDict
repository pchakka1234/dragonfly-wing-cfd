FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}

application     pimpleFoam;
startFrom       startTime;  // FORCE start from 0
startTime       0;
stopAt          endTime;
endTime         100;
deltaT          1e-4;
writeControl    timeStep;
writeInterval   50;
purgeWrite      0;
writeFormat     ascii;
writePrecision  6;
writeCompression off;
timeFormat      general;
timePrecision   6;
runTimeModifiable true;

functions
{
    forces
    {
        type forces;
        functionObjectLibs ("libforces.so");
        patches (dragonfly);
        rho rhoInf;
        rhoInf 1.0;
        CofR (0 0 0);
    }
}
