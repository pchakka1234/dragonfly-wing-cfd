/*--------------------------------*- C++ -*----------------------------------*\
| OpenFOAM: The Open Source CFD Toolbox           |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
convertToMeters 1;

vertices
(
    // A tight 10cm box around the wing
    (-0.05 -0.05 -0.05) // 0
    ( 0.05 -0.05 -0.05) // 1
    ( 0.05  0.05 -0.05) // 2
    (-0.05  0.05 -0.05) // 3
    (-0.05 -0.05  0.05) // 4
    ( 0.05 -0.05  0.05) // 5
    ( 0.05  0.05  0.05) // 6
    (-0.05  0.05  0.05) // 7
);

blocks
(
    // CHANGED from 40 to 41 to prevent grid alignment crash
    hex (0 1 2 3 4 5 6 7) (41 41 41) simpleGrading (1 1 1)
);

boundary
(
    inlet
    {
        type patch;
        faces
        (
            (0 4 7 3)    // x = -0.05
        );
    }
    outlet
    {
        type patch;
        faces
        (
            (1 2 6 5)    // x = +0.05
        );
    }
    sides
    {
        type patch;
        faces
        (
            (0 1 5 4)    // y = -0.05
            (3 7 6 2)    // y = +0.05
            (4 5 6 7)    // z = +0.05
            (0 3 2 1)    // z = -0.05
        );
    }
);
